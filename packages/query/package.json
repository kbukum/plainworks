{
  "name": "@plainworks/query",
  "version": "0.1.0-alpha.1",
  "description": "Host-independent TanStack Query provider, protocol-agnostic cache routing, event sink, remote StateSource scope, and PostgREST list-query cache keys.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/query#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/query"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "host-independent",
    "tanstack-query",
    "react-query",
    "cache",
    "postgrest"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cache": {
      "@plainworks/source": "./src/cache/index.ts",
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./hydration": {
      "@plainworks/source": "./src/hydration/index.ts",
      "types": "./dist/hydration.d.ts",
      "default": "./dist/hydration.js"
    },
    "./list": {
      "@plainworks/source": "./src/list/index.ts",
      "types": "./dist/list.d.ts",
      "default": "./dist/list.js"
    },
    "./mutation": {
      "@plainworks/source": "./src/mutation/index.ts",
      "types": "./dist/mutation.d.ts",
      "default": "./dist/mutation.js"
    },
    "./http-list": {
      "@plainworks/source": "./src/http-list/index.ts",
      "types": "./dist/http-list.d.ts",
      "default": "./dist/http-list.js"
    },
    "./remote": {
      "@plainworks/source": "./src/remote/index.ts",
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    },
    "./client": {
      "@plainworks/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "check-packaging": "plainworks-release check-packaging"
  },
  "dependencies": {
    "@plainworks/state": "workspace:*",
    "@plainworks/std": "workspace:*"
  },
  "devDependencies": {
    "@plainworks/http": "workspace:*",
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@plainworks/http": "workspace:*",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@plainworks/http": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
