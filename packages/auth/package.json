{
  "name": "@plainworks/auth",
  "version": "0.1.0-alpha.1",
  "description": "Pluggable authentication and authorization: host-neutral core, secure BFF default, swappable adapters.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/auth"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "host-independent",
    "auth",
    "authentication",
    "authorization",
    "oidc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "@plainworks/source": "./src/adapter/index.ts",
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./authz": {
      "@plainworks/source": "./src/authz/index.ts",
      "types": "./dist/authz.d.ts",
      "default": "./dist/authz.js"
    },
    "./crypto": {
      "@plainworks/source": "./src/crypto/index.ts",
      "types": "./dist/crypto.d.ts",
      "default": "./dist/crypto.js"
    },
    "./csrf": {
      "@plainworks/source": "./src/csrf/index.ts",
      "types": "./dist/csrf.d.ts",
      "default": "./dist/csrf.js"
    },
    "./redirect": {
      "@plainworks/source": "./src/redirect/index.ts",
      "types": "./dist/redirect.d.ts",
      "default": "./dist/redirect.js"
    },
    "./session": {
      "@plainworks/source": "./src/session/index.ts",
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./session-store": {
      "@plainworks/source": "./src/session-store/index.ts",
      "types": "./dist/session-store.d.ts",
      "default": "./dist/session-store.js"
    },
    "./signer": {
      "@plainworks/source": "./src/signer/index.ts",
      "types": "./dist/signer.d.ts",
      "default": "./dist/signer.js"
    },
    "./server": {
      "@plainworks/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "@plainworks/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./form-post": {
      "@plainworks/source": "./src/adapters/form-post.ts",
      "types": "./dist/form-post.d.ts",
      "default": "./dist/form-post.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.adapters.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "check-packaging": "plainworks-release check-packaging"
  },
  "dependencies": {
    "@plainworks/state": "workspace:*",
    "@plainworks/std": "workspace:*",
    "jose": "catalog:",
    "oauth4webapi": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@plainworks/mocks": "workspace:*",
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
