{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Files outside a package that every package task reads: the shared tsconfigs projects extend,
  // the portability shim each project includes from `types/`, the Biome config, and the shared
  // build and test presets (they have no `build` task, so `^build` carries no hash for them).
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.tool.json",
    "tsconfig.app.json",
    "types/**",
    "biome.json",
    "internal/tsdown-config/src/**",
    "internal/vitest-config/src/**"
  ],
  "tasks": {
    // Every task hashes the package's whole tracked tree (`$TURBO_DEFAULT$`) and drops only what
    // cannot change its result, so a new config file, script, lock, or fixture busts the cache
    // without anyone listing it.
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "check-packaging": {
      // `plainworks-release check-packaging` validates the packed tarball, so depend on this
      // package's own `build` and read `dist` plus the tracked files that are packed with it.
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "dist/**"],
      "outputs": []
    },
    "check-production": {
      // Runs the host's own source-mapped analysis build, so it needs only built dependencies.
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["coverage/**"]
    }
  }
}
