{
  "extends": "../../tsconfig.base.json",
  // Client project, but React-without-DOM: the `./client` bindings are pure React context and
  // hooks, so they compile against the universal-web shim, never the DOM libs. That keeps
  // `@plainworks/state/client` usable on React Native/Expo as well as in the browser.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "include": ["src/client.ts", "src/client", "../../types/universal-web.d.ts"]
}
