{
  "extends": "../../tsconfig.base.json",
  // Test project: the suites mount components in jsdom, so they add the DOM libs. The shipped `.`,
  // `./client`, and `./capabilities` graphs stay DOM-free in their own projects, so an accidental
  // `window`/`document` in shipped code fails to compile instead of hiding behind these libs.
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
