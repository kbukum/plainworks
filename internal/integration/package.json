{
  "name": "@plainworks/integration",
  "version": "0.0.0",
  "description": "Dev-only integration tests. Assembles the published @plainworks/* surfaces the way a consumer does — edges faked with the MSW mock service and in-memory doubles — and proves the list wire round-trips end-to-end. Never published; nothing depends on it.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "ui:capture": "bun src/system/ui-capture.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@plainworks/auth": "workspace:*",
    "@plainworks/channel": "workspace:*",
    "@plainworks/connect": "workspace:*",
    "@plainworks/demo": "workspace:*",
    "@plainworks/http": "workspace:*",
    "@plainworks/query": "workspace:*",
    "@plainworks/std": "workspace:*"
  },
  "devDependencies": {
    "@plainworks/mocks": "workspace:*",
    "@plainworks/testkit": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
