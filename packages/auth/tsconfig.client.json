{
  "extends": "../../tsconfig.base.json",
  // Client-only project: the `./client` graph (`src/client.ts` + `src/client/`) is the sole surface
  // allowed to touch the DOM (React bindings), so it — and only it — layers the DOM libs on top of
  // the base config. The server project (`tsconfig.src.json`) stays DOM-free and excludes this
  // graph, so the `.`/`./server` entries can never silently depend on a browser global.
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/client.ts", "src/client", "../../types/universal-web.d.ts"]
}
