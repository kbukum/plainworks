{{#if hasClient}}{
  // Editor routing only. The TypeScript language service (VS Code) auto-discovers a file named
  // `tsconfig.json` and its `references` — never a differently named `tsconfig.src.json`,
  // `tsconfig.client.json`, or `tsconfig.test.json`. This solution file carries no files of its own;
  // it points the language service at the real projects so each source file is checked by the project
  // that includes it. Without it, any file the server project excludes (the client graph, DOM tests)
  // falls back to the DOM-free root `tsconfig.json` and mis-reports DOM globals like `document`. The
  // CLI runs each referenced project directly (`tsc -p ...`), so this file is never passed to `tsc`.
  "files": [],
  "references": [{ "path": "./tsconfig.src.json" }, { "path": "./tsconfig.client.json" }]
}
{{else}}{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "../../types/universal-web.d.ts"]
}
{{/if}}
