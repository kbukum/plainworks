{
  "name": "@plainworks/elements",
  "version": "0.1.0-alpha.1",
  "description": "Owned Base-UI/shadcn atoms for the plainworks UI family, ingested and refreshed through the shadcn CLI.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/elements#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/elements"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "host-independent",
    "react",
    "shadcn",
    "base-ui",
    "components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "registry.json",
    "src/atoms",
    "!src/atoms/**/*.test.*",
    "src/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
