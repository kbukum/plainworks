{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // The portability test compiles every package's neutral project (`tsconfig.src.json`, or
      // `tsconfig.json` for a single-project package) from outside this package, so those configs
      // bust the cache too.
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/*/tsconfig.src.json"
      ]
    }
  }
}
