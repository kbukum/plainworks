{
  "name": "plainworks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Foundational, host-independent React/TypeScript kit.",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "bun": ">=1.3.6"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "packages/*",
    "apps/*",
    "internal/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p turbo/generators/tsconfig.json",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check-boundaries": "bun run --filter @plainworks/boundaries check",
    "check-packaging": "turbo run check-packaging",
    "check-versions": "sherif && syncpack lint",
    "gen": "gen run",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@turbo/gen": "catalog:",
    "sherif": "catalog:",
    "syncpack": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "catalog": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^3.0.2",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@turbo/gen": "^2.10.12",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^30.0.1",
    "msw": "^2.12.8",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sherif": "^1.13.0",
    "syncpack": "^15.3.3",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
