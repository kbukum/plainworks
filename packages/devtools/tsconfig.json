{
  // Editor routing only. The TypeScript language service auto-discovers `tsconfig.json` and its
  // `references` — never a differently named `tsconfig.src.json` or `tsconfig.client.json`. This
  // solution file carries no files of its own; it points the language service at the real projects
  // so each source file is checked by the project that includes it. The CLI runs each referenced
  // project directly (`tsc -p ...`), so this file is never passed to `tsc`.
  "files": [],
  "references": [{ "path": "./tsconfig.src.json" }, { "path": "./tsconfig.client.json" }]
}
