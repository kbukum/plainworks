    },
    "./scroll-area": {
      "types": "./dist/scroll-area.d.ts",
      "default": "./dist/scroll-area.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "default": "./dist/select.js"
    },
    "./separator": {
      "types": "./dist/separator.d.ts",
      "default": "./dist/separator.js"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "default": "./dist/sheet.js"
    },
    "./skeleton": {
      "types": "./dist/skeleton.d.ts",
      "default": "./dist/skeleton.js"
    },
    "./slider": {
      "types": "./dist/slider.d.ts",
      "default": "./dist/slider.js"
    },
    "./spinner": {
      "types": "./dist/spinner.d.ts",
      "default": "./dist/spinner.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "default": "./dist/switch.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "default": "./dist/tabs.js"
    },
    "./textarea": {
      "types": "./dist/textarea.d.ts",
      "default": "./dist/textarea.js"
    },
    "./toast": {
      "types": "./dist/toast.d.ts",
      "default": "./dist/toast.js"
    },
    "./toggle": {
      "types": "./dist/toggle.d.ts",
      "default": "./dist/toggle.js"
    },
    "./toggle-group": {
      "types": "./dist/toggle-group.d.ts",
      "default": "./dist/toggle-group.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "default": "./dist/tooltip.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.shadcn.json",
    "test": "vitest run --coverage",
    "check-packaging": "plainworks-release check-packaging",
    "registry:add": "bun scripts/registry/cli.ts add",
    "registry:update": "bun scripts/registry/cli.ts update",
    "registry:diff": "bun scripts/registry/cli.ts diff",
    "registry:validate": "bun scripts/registry/cli.ts validate",
    "registry:codegen": "bun scripts/registry/cli.ts codegen"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@plainworks/theme": "workspace:*",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "input-otp": "catalog:",
    "lucide-react": "catalog:",
    "react-day-picker": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "shadcn": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
