{
  "extends": "../../tsconfig.base.json",
  // Test project: the stylesheet suites load the shipped CSS from disk through the `src/testing/`
  // readers and run the Tailwind compiler, so they see Node types. The DOM suite
  // that loads `tokens.css` into a plain document adds the DOM libs. The shipped `.` and `./client`
  // graphs stay in their own projects, so no Node or DOM global leaks into published code.
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts"],
  "exclude": ["src/client"]
}
