{
  "extends": "../../tsconfig.base.json",
  // The `./testing` profile: the private stylesheet and contrast readers (`src/testing/`) load the
  // shipped CSS from disk, so they see Node types. No production module may import them (a boundary
  // rule), and the package does not export them.
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/testing"]
}
