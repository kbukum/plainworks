{
  "extends": "../../tsconfig.base.json",
  // Client project for the atoms plainworks writes (`src/atoms/`), held to the full strict base.
  // Atoms are the surface allowed to touch the DOM, so only the client projects add DOM libs; the
  // server project stays DOM-free, so the `.` manifest can never silently depend on a browser
  // global. Vendored shadcn atoms are checked by `tsconfig.shadcn.json`.
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/atoms"]
}
