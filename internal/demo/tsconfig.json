{
  "extends": "../../tsconfig.base.json",
  // Dev/test fixtures: the MSW handlers and the mock graph use Web/Fetch globals (URL, Request,
  // Response, Headers, crypto) and Node APIs the host-independent base config hides via `types: []`.
  // Opt back into Node's typings, per the base config's note for host-bound tooling.
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src"]
}
