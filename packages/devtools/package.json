{
  "name": "@plainworks/devtools",
  "version": "0.1.0-alpha.1",
  "description": "Development-only, host-independent runtime inspector with a neutral serializable session protocol.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/devtools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/devtools"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "host-independent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@plainworks/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./bridge": {
      "@plainworks/source": "./src/bridge/index.ts",
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./privacy": {
      "@plainworks/source": "./src/privacy/index.ts",
      "types": "./dist/privacy.d.ts",
      "default": "./dist/privacy.js"
    },
    "./retention": {
      "@plainworks/source": "./src/retention/index.ts",
      "types": "./dist/retention.d.ts",
      "default": "./dist/retention.js"
    },
    "./session": {
      "@plainworks/source": "./src/session/index.ts",
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./store": {
      "@plainworks/source": "./src/store/index.ts",
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./launch": {
      "@plainworks/source": "./src/launch/index.ts",
      "types": "./dist/launch.d.ts",
      "default": "./dist/launch.js"
    },
    "./query": {
      "@plainworks/source": "./src/adapters/query/index.ts",
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./state": {
      "@plainworks/source": "./src/adapters/state/index.ts",
      "types": "./dist/state.d.ts",
      "default": "./dist/state.js"
    },
    "./http": {
      "@plainworks/source": "./src/adapters/http/index.ts",
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./connect": {
      "@plainworks/source": "./src/adapters/connect/index.ts",
      "types": "./dist/connect.d.ts",
      "default": "./dist/connect.js"
    },
    "./channel": {
      "@plainworks/source": "./src/adapters/channel/index.ts",
      "types": "./dist/channel.d.ts",
      "default": "./dist/channel.js"
    },
    "./observability": {
      "@plainworks/source": "./src/adapters/observability/index.ts",
      "types": "./dist/observability.d.ts",
      "default": "./dist/observability.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown && bun scripts/styles/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.fixtures.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run --coverage",
    "check-packaging": "plainworks-release check-packaging"
  },
  "dependencies": {
    "@plainworks/elements": "workspace:*",
    "@plainworks/state": "workspace:*",
    "@plainworks/std": "workspace:*",
    "@plainworks/theme": "workspace:*",
    "@plainworks/ui": "workspace:*",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "@connectrpc/connect": "catalog:",
    "@plainworks/channel": "workspace:*",
    "@plainworks/connect": "workspace:*",
    "@plainworks/http": "workspace:*",
    "@plainworks/observability": "workspace:*",
    "@tanstack/query-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@plainworks/channel": {
      "optional": true
    },
    "@plainworks/connect": {
      "optional": true
    },
    "@plainworks/http": {
      "optional": true
    },
    "@plainworks/observability": {
      "optional": true
    },
    "@connectrpc/connect": {
      "optional": true
    },
    "@tanstack/query-core": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@connectrpc/connect": "catalog:",
    "@plainworks/channel": "workspace:*",
    "@plainworks/connect": "workspace:*",
    "@plainworks/http": "workspace:*",
    "@plainworks/observability": "workspace:*",
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@tailwindcss/oxide": "catalog:",
    "@tanstack/query-core": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "lightningcss": "catalog:",
    "postcss": "catalog:",
    "postcss-selector-parser": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
