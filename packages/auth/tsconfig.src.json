{
  "extends": "../../tsconfig.base.json",
  // Server project: the neutral `.` and token-bearing `./server` entries, DOM-free with the
  // universal-web shim. The React bindings live in `tsconfig.client.json`, the browser navigator in
  // `tsconfig.adapters.json`, and their DOM-backed tests in `tsconfig.test.json`. The neutral tests
  // stay here, DOM-free.
  "exclude": ["src/client.ts", "src/client", "src/adapters"],
  "include": ["src", "../../types/universal-web.d.ts"]
}
