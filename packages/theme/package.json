{
  "name": "@plainworks/theme",
  "version": "0.1.0-alpha.1",
  "description": "The host-independent design substrate for the plainworks UI family: semantic tokens as plain CSS and Tailwind utilities, color schemes + dark mode, the resolve→hydrate theme runtime, and the `cn` class merger.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/theme"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "host-independent",
    "design-tokens",
    "theme",
    "tailwind"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@plainworks/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "check-packaging": "plainworks-release check-packaging"
  },
  "dependencies": {
    "@plainworks/std": "workspace:*",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
