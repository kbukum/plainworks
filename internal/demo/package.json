{
  "name": "@plainworks/demo",
  "version": "0.0.0",
  "description": "Dev-only demo domain: the fake commerce/SaaS fixture set (users, orders, products, tasks, content, notifications, settings, dashboard) and the createMockApi graph that wires it from @plainworks/mocks primitives. Never published; the showcase and integration tests run against it.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@plainworks/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./events": {
      "@plainworks/source": "./src/events/index.ts",
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "scripts": {
    "proto:generate": "buf generate proto",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@plainworks/mocks": "workspace:*",
    "@plainworks/std": "workspace:*",
    "msw": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
