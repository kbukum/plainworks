{
  "name": "@plainworks/ui",
  "version": "0.1.0-alpha.1",
  "description": "Accessible, ownable React components and theme building blocks for plainworks applications.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Plainworks",
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "dependencies": {
    "@plainworks/elements": "workspace:*",
    "@plainworks/std": "workspace:*",
    "@plainworks/theme": "workspace:*"
  },
  "devDependencies": {
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@plainworks/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./hooks": {
      "@plainworks/source": "./src/client/hooks/index.ts",
      "types": "./dist/hooks.d.ts",
      "default": "./dist/hooks.js"
    },
    "./layout": {
      "@plainworks/source": "./src/client/layout/index.ts",
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./feedback": {
      "@plainworks/source": "./src/client/feedback/index.ts",
      "types": "./dist/feedback.d.ts",
      "default": "./dist/feedback.js"
    },
    "./overlays": {
      "@plainworks/source": "./src/client/overlays/index.ts",
      "types": "./dist/overlays.d.ts",
      "default": "./dist/overlays.js"
    },
    "./display": {
      "@plainworks/source": "./src/client/display/index.ts",
      "types": "./dist/display.d.ts",
      "default": "./dist/display.js"
    },
    "./navigation": {
      "@plainworks/source": "./src/client/navigation/index.ts",
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./data-table": {
      "@plainworks/source": "./src/client/data-table/index.ts",
      "types": "./dist/data-table.d.ts",
      "default": "./dist/data-table.js"
    },
    "./forms": {
      "@plainworks/source": "./src/client/forms/index.ts",
      "types": "./dist/forms.d.ts",
      "default": "./dist/forms.js"
    },
    "./list": {
      "@plainworks/source": "./src/client/list/index.ts",
      "types": "./dist/list.d.ts",
      "default": "./dist/list.js"
    },
    "./page": {
      "@plainworks/source": "./src/client/page/index.ts",
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./shell": {
      "@plainworks/source": "./src/client/shell/index.ts",
      "types": "./dist/shell.d.ts",
      "default": "./dist/shell.js"
    },
    "./theme": {
      "@plainworks/source": "./src/client/theme/index.ts",
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "registry.json"
  ],
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/ui#readme",
  "keywords": [
    "esm",
    "host-independent",
    "plainworks",
    "typescript"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "build": "tsdown",
    "check-packaging": "plainworks-release check-packaging",
    "codegen": "bun scripts/codegen/cli.ts",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.scripts.json"
  }
}
