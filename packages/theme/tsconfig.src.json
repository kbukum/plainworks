{
  "extends": "../../tsconfig.base.json",
  // Server project: the `.` entry must stay DOM-free. The client graph (`src/client.ts` +
  // `src/client/`) is excluded here and typechecked with DOM libs via `tsconfig.client.json`. The
  // neutral tokens/theme/`cn` under `src` stay here so a host-only global on the `.` entry fails to
  // compile (the portability gate).
  "compilerOptions": {
    "paths": {
      "@plainworks/*": ["../*/src"]
    }
  },
  // The token-contract test inspects `styles.css` from disk via Node `fs` — a dev-only assertion of
  // a build artifact. It sits outside this DOM- and Node-free graph (its `node:` imports would
  // otherwise, correctly, fail to resolve here) and is exercised by Vitest, not `tsc`.
  "exclude": ["src/client.ts", "src/client", "src/tokens/tokens.test.ts", "src/styles.test.ts"],
  "include": ["src", "../../types/universal-web.d.ts"]
}
