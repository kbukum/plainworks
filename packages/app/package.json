{
  "name": "@plainworks/app",
  "version": "0.1.0-alpha.1",
  "description": "Composition kernel: wire the plainworks concern packages into a working app through an injected capability registry, host-neutral, no singletons.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/app"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "host-independent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@plainworks/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./capabilities/auth": {
      "@plainworks/source": "./src/capabilities/auth.ts",
      "types": "./dist/capabilities/auth.d.ts",
      "default": "./dist/capabilities/auth.js"
    },
    "./capabilities/query": {
      "@plainworks/source": "./src/capabilities/query.ts",
      "types": "./dist/capabilities/query.d.ts",
      "default": "./dist/capabilities/query.js"
    },
    "./capabilities/state": {
      "@plainworks/source": "./src/capabilities/state.ts",
      "types": "./dist/capabilities/state.d.ts",
      "default": "./dist/capabilities/state.js"
    },
    "./testing": {
      "@plainworks/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.testing.json",
    "test": "vitest run --coverage",
    "check-packaging": "plainworks-release check-packaging"
  },
  "dependencies": {
    "@plainworks/std": "workspace:*"
  },
  "devDependencies": {
    "@plainworks/auth": "workspace:*",
    "@plainworks/query": "workspace:*",
    "@plainworks/state": "workspace:*",
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@plainworks/auth": "workspace:*",
    "@plainworks/query": "workspace:*",
    "@plainworks/state": "workspace:*",
    "@tanstack/query-core": "catalog:",
    "@testing-library/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@plainworks/auth": {
      "optional": true
    },
    "@plainworks/query": {
      "optional": true
    },
    "@plainworks/state": {
      "optional": true
    },
    "@tanstack/query-core": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
