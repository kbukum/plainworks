{
  "extends": "../../tsconfig.base.json",
  // Adapter project: the Web Vitals collector (`./web-vitals`) defaults to the host
  // `PerformanceObserver` and `document`, so this project alone adds the DOM libs.
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "exclude": ["src/**/*.test.ts"],
  "include": ["src/adapters"]
}
