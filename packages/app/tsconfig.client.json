{
  "extends": "../../tsconfig.base.json",
  // Client project, but React-without-DOM: the `./client` binding and the `./capabilities` recipe
  // graph are pure React context (provider composition, an error boundary, TanStack/auth wiring) with
  // no DOM global, so they stay DOM-free like the server entry — the universal-web shim, not the DOM
  // libs. That keeps them usable on React Native/Expo, and makes an accidental `window`/`document`
  // fail to compile. The DOM-bound `./testing` harness and every `*.test.*` live in
  // `tsconfig.test.json`, so they are excluded here. The http recipe's test is the exception: it
  // renders `@plainworks/http` source, which compiles only against the universal-web shim, so it
  // is listed in `files` (which `exclude` does not filter) and checked here instead.
  "exclude": ["src/capabilities/theme", "src/**/*.test.ts", "src/**/*.test.tsx"],
  "files": ["src/capabilities/http.test.tsx"],
  "include": ["src/client.ts", "src/client", "src/capabilities", "../../types/universal-web.d.ts"]
}
