{
  "extends": "../../tsconfig.base.json",
  // Dev-only stylesheet build under `scripts/`, run with bun after tsdown. It reads the filesystem
  // and drives the CSS toolchain (Tailwind, lightningcss, postcss, Vite), so it opts into Node
  // types — unlike the package source, which stays host-independent and DOM/Node-free. Kept a
  // separate project so those globals never leak into the shipped graph.
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["scripts"]
}
