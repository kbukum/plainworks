{
  "name": "@plainworks/elements",
  "version": "0.1.0-alpha.1",
  "description": "Vendored, locked Base-UI/shadcn atoms for the plainworks UI family, refreshed only through the shadcn CLI.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/elements#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/elements"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "host-independent",
    "react",
    "shadcn",
    "base-ui",
    "components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "registry.json",
    "shadcn.lock.json"
  ],
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "default": "./dist/accordion.js"
    },
    "./alert": {
      "types": "./dist/alert.d.ts",
      "default": "./dist/alert.js"
    },
    "./alert-dialog": {
      "types": "./dist/alert-dialog.d.ts",
      "default": "./dist/alert-dialog.js"
    },
    "./aspect-ratio": {
      "types": "./dist/aspect-ratio.d.ts",
      "default": "./dist/aspect-ratio.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "default": "./dist/avatar.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "default": "./dist/badge.js"
    },
    "./breadcrumb": {
      "types": "./dist/breadcrumb.d.ts",
      "default": "./dist/breadcrumb.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./button-group": {
      "types": "./dist/button-group.d.ts",
      "default": "./dist/button-group.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "default": "./dist/calendar.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "default": "./dist/card.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "default": "./dist/checkbox.js"
    },
    "./collapsible": {
      "types": "./dist/collapsible.d.ts",
      "default": "./dist/collapsible.js"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "default": "./dist/command.js"
    },
    "./context-menu": {
      "types": "./dist/context-menu.d.ts",
      "default": "./dist/context-menu.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "default": "./dist/dialog.js"
    },
    "./dropdown-menu": {
      "types": "./dist/dropdown-menu.d.ts",
      "default": "./dist/dropdown-menu.js"
    },
    "./empty": {
      "types": "./dist/empty.d.ts",
      "default": "./dist/empty.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "default": "./dist/field.js"
    },
    "./hover-card": {
      "types": "./dist/hover-card.d.ts",
      "default": "./dist/hover-card.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "default": "./dist/input.js"
    },
    "./input-group": {
      "types": "./dist/input-group.d.ts",
      "default": "./dist/input-group.js"
    },
    "./input-otp": {
      "types": "./dist/input-otp.d.ts",
      "default": "./dist/input-otp.js"
    },
    "./item": {
      "types": "./dist/item.d.ts",
      "default": "./dist/item.js"
    },
    "./kbd": {
      "types": "./dist/kbd.d.ts",
