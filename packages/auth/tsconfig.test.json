{
  "extends": "../../tsconfig.base.json",
  // Test project for the client and adapter tests: they render with jsdom and drive DOM globals, so
  // this project adds the DOM libs. The client and adapter projects exclude tests, and the neutral
  // tests stay in the DOM-free `tsconfig.src.json`, so DOM never reaches a neutral graph.
  "include": [
    "src/client/**/*.test.ts",
    "src/client/**/*.test.tsx",
    "src/testing/**/*.test.ts",
    "../../types/universal-web.d.ts"
  ]
}
