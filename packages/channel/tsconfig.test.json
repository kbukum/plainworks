{
  "extends": "../../tsconfig.base.json",
  // Test project for the client tests: they render with jsdom and read DOM nodes, so this project
  // adds the DOM libs. The client project excludes tests, and the neutral tests stay in the DOM-free
  // `tsconfig.src.json`, so DOM never reaches a neutral graph.
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/client/**/*.test.ts", "src/client/**/*.test.tsx"]
}
