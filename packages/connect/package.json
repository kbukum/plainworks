{
  "name": "@plainworks/connect",
  "version": "0.1.0-alpha.1",
  "description": "Host-independent Connect-RPC (Connect-ES v2) integration with transport factory, auth and resilience interceptors, typed RpcError, and connect-query key conventions.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/connect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/connect"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "host-independent",
    "connect-rpc",
    "connect-es",
    "protobuf",
    "tanstack-query"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./interceptor": {
      "@plainworks/source": "./src/interceptor/index.ts",
      "types": "./dist/interceptor.d.ts",
      "default": "./dist/interceptor.js"
    },
    "./query": {
      "@plainworks/source": "./src/query/index.ts",
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./forms": {
      "@plainworks/source": "./src/forms/index.ts",
      "types": "./dist/forms.d.ts",
      "default": "./dist/forms.js"
    },
    "./testing": {
      "@plainworks/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./client": {
      "@plainworks/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "gen:proto": "buf generate",
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.testing.json",
    "test": "vitest run --coverage",
    "check-packaging": "plainworks-release check-packaging"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@bufbuild/protovalidate": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-query-core": "catalog:",
    "@connectrpc/connect-web": "catalog:",
    "@plainworks/std": "workspace:*"
  },
  "devDependencies": {
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@connectrpc/connect-query": "catalog:",
    "@plainworks/mocks": "workspace:*",
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@connectrpc/connect-query": "catalog:",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@connectrpc/connect-query": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
