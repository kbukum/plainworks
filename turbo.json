{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Files outside a package that every package task reads: the base tsconfig every project extends,
  // the portability shim each project includes from `types/`, the Biome config, and the shared
  // tsdown preset (it has no `build` task, so `^build` carries no hash for it).
  "globalDependencies": [
    "tsconfig.base.json",
    "types/**",
    "biome.json",
    "internal/tsdown-config/src/**"
  ],
  "tasks": {
    // Every task hashes the package's whole tracked tree (`$TURBO_DEFAULT$`) and drops only what
    // cannot change its result, so a new config file, script, lock, or fixture busts the cache
    // without anyone listing it.
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "check-packaging": {
      // publint + attw validate the *built* tarball (exports/types/files resolution), so depend on
      // this package's own `build` and read `dist` plus the tracked files that are packed with it.
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "dist/**"],
      "outputs": []
    },
    "check-production": {
      // Runs the host's own source-mapped analysis build, so it needs only built dependencies.
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    }
  }
}
