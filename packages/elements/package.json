  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run --coverage",
    "lint": "biome check .",
    "check-packaging": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints @plainworks/elements/styles.css",
    "registry:add": "node scripts/registry/cli.mjs add",
    "registry:update": "node scripts/registry/cli.mjs update",
    "registry:diff": "node scripts/registry/cli.mjs diff",
    "registry:validate": "node scripts/registry/cli.mjs validate",
    "registry:codegen": "node scripts/registry/cli.mjs codegen"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@plainworks/theme": "workspace:*",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "input-otp": "catalog:",
    "lucide-react": "catalog:",
    "react-day-picker": "catalog:",
    "sonner": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "publint": "catalog:",
    "shadcn": "catalog:",
