{
  "extends": "../../tsconfig.base.json",
  // Client project, but React-without-DOM: the `./client` session hooks, gates, and login/logout
  // actions compile against the universal-web shim, never the DOM libs, so
  // `@plainworks/auth/client` runs on React Native/Expo as well as in the browser.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "include": ["src/client.ts", "src/client", "../../types/universal-web.d.ts"]
}
