{
  "name": "@plainworks/showcase",
  "version": "0.0.0",
  "description": "Production-shaped showcase: a server-rendered dashboard assembling published @plainworks/* surfaces over the demo backend. Never published; nothing depends on it.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run server.ts",
    "build": "NODE_ENV=production vite build",
    "check-production": "NODE_ENV=production vite build --sourcemap hidden --outDir .bundle-analysis --emptyOutDir --logLevel warn && bun ../../internal/bundle-exclusion/cli.ts devtools-exclusion.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@plainworks/app": "workspace:*",
    "@plainworks/auth": "workspace:*",
    "@plainworks/channel": "workspace:*",
    "@plainworks/demo": "workspace:*",
    "@plainworks/devtools": "workspace:*",
    "@plainworks/elements": "workspace:*",
    "@plainworks/http": "workspace:*",
    "@plainworks/mocks": "workspace:*",
    "@plainworks/query": "workspace:*",
    "@plainworks/state": "workspace:*",
    "@plainworks/std": "workspace:*",
    "@plainworks/theme": "workspace:*",
    "@plainworks/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@plainworks/testkit": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",

    "jsdom": "catalog:",
    "msw": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
