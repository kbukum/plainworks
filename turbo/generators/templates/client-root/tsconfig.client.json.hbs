{
  "extends": "../../tsconfig.base.json",
  // Client project, but React-without-DOM: the `./client` bindings compile against the
  // universal-web shim, never the DOM libs, so they also run on React Native. Browser behavior
  // belongs on an adapter subpath named after what it does, in its own DOM project.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "include": ["src/client.ts", "src/client", "../../types/universal-web.d.ts"]
}
