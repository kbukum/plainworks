{
  "name": "@plainworks/testkit",
  "version": "0.1.0-alpha.1",
  "description": "Shared, deterministic test harnesses and seam fakes for testing plainworks packages.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/testkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/testkit"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "testing",
    "test-harness",
    "fakes",
    "playwright"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fakes": {
      "@plainworks/source": "./src/fakes/index.ts",
      "types": "./dist/fakes.d.ts",
      "default": "./dist/fakes.js"
    },
    "./connect": {
      "@plainworks/source": "./src/connect/index.ts",
      "types": "./dist/connect.d.ts",
      "default": "./dist/connect.js"
    },
    "./client": {
      "@plainworks/source": "./src/client/index.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./query": {
      "@plainworks/source": "./src/query/index.ts",
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./playwright": {
      "@plainworks/source": "./src/playwright/index.ts",
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.playwright.json",
    "test": "vitest run --coverage",
    "gen:proto": "buf generate",
    "check-packaging": "plainworks-release check-packaging"
  },
  "dependencies": {
    "@bufbuild/protovalidate": "catalog:",
    "@plainworks/std": "workspace:*",
    "@testing-library/react": "catalog:",
    "pixelmatch": "catalog:",
    "pngjs": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@axe-core/playwright": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@playwright/test": "catalog:",
    "@tanstack/react-query": "catalog:",
    "axe-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    },
    "@bufbuild/protobuf": {
      "optional": true
    },
    "@connectrpc/connect": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
