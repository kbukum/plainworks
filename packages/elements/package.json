      "default": "./dist/menubar.js"
    },
    "./native-select": {
      "types": "./dist/native-select.d.ts",
      "default": "./dist/native-select.js"
    },
    "./navigation-menu": {
      "types": "./dist/navigation-menu.d.ts",
      "default": "./dist/navigation-menu.js"
    },
    "./number-field": {
      "@plainworks/source": "./src/atoms/number-field.tsx",
      "types": "./dist/number-field.d.ts",
      "default": "./dist/number-field.js"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "default": "./dist/pagination.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "default": "./dist/popover.js"
