# Dependencies (bun installs here, incl. the isolated .bun store)
node_modules/

# Build output — every package ships a freshly built dist/, never a committed one
dist/
*.tsbuildinfo

# Generated eject payload — create-plainworks rebuilds examples/ from the apps/* source apps on
# every build and ships it via `files`; the apps are the single source of truth, never this copy.
packages/create-plainworks/examples/

# Emitted type declarations never belong in a package's src/ — the build emits them to dist/.
# This stops a stray `tsc` (without --noEmit) from leaking .d.ts artifacts into source. The global
# ambient shim lives under types/, not a package src/, so it is unaffected.
packages/*/src/**/*.d.ts
internal/*/src/**/*.d.ts

# Test coverage (vitest / v8)
coverage/
*.lcov

# Turbo local task cache
.turbo/

# Packing artifacts from `bun pm pack` / `npm pack`
*.tgz

# Environment: never commit real env files; the checked-in template is the exception
.env
.env.*
!.env.example

# Scratch space for planning docs, notes, and throwaway experiments — the folder is
# tracked (via .keep) but its contents never are.
/tmp/*
!/tmp/.keep

# Editor / OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
# Shared editor config: `turbo.json` / `biome.json` are JSONC but VS Code only treats
# `tsconfig*.json` as JSONC natively, so this workspace file maps them to avoid false "comments not
# permitted" errors. Kept in git so every contributor gets it (the rest of `.vscode/` stays ignored).
!.vscode/settings.json
*.swp
*.swo
*~
*.log
