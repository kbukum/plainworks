{
  "name": "plainworks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Foundational, host-independent React/TypeScript kit.",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "bun": ">=1.3.6"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "packages/*",
    "apps/*",
    "internal/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p turbo/generators/tsconfig.json",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check-boundaries": "bun run --filter @plainworks/boundaries check",
    "check-comments": "bun run --filter @plainworks/comment-format check",
    "format-comments": "bun run --filter @plainworks/comment-format write",
    "check-packaging": "turbo run check-packaging",
    "check-versions": "sherif && syncpack lint",
    "gen": "gen run",
    "gen:proto": "bun run --filter @plainworks/testkit gen:proto",
    "changeset": "changeset",
    "version:packages": "changeset version && node packages/create-plainworks/scripts/sync-versions.mjs && bun install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@turbo/gen": "catalog:",
    "sherif": "catalog:",
    "syncpack": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "catalog": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "^1.8.0",
    "@biomejs/biome": "^2.5.12",
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protobuf": "^2.14.1",
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "@changesets/cli": "^3.0.2",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-query": "^2.3.1",
    "@connectrpc/connect-query-core": "^2.3.1",
    "@connectrpc/connect-web": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-core": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@turbo/gen": "^2.10.12",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dependency-cruiser": "^18.2.0",
    "eventsource-parser": "^4.1.0",
    "input-otp": "^1.5.0",
    "jose": "^6.2.12",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.45.0",
    "msw": "^2.12.8",
    "next": "^16.3.5",
    "oauth4webapi": "^3.8.8",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sherif": "^1.13.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "syncpack": "^15.3.3",
    "tailwindcss": "^4.3.3",
    "tailwind-merge": "^3.3.1",
    "tsdown": "^0.23.0",
    "turbo": "^2.10.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
