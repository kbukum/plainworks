{
  "rule": "devtools",
  "directories": [".bundle-analysis/static", ".bundle-analysis/server"],
  "expectedSources": ["./src/"],
  "forbiddenSources": ["./src/client/dev-tools/"],
  "allowUnmapped": [
    ".bundle-analysis/build-manifest.json#polyfillFiles",
    ".bundle-analysis/build-manifest.json#lowPriorityFiles",
    ".bundle-analysis/server/**/*-manifest.js"
  ]
}
