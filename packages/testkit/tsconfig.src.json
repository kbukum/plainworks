{
  "extends": "../../tsconfig.base.json",
  // Server project: the `.` entry must stay DOM-free. The client graph (`src/client/`) and the
  // Playwright browser gate (`src/browser/`) are excluded here and typechecked with DOM libs via
  // `tsconfig.client.json` and `tsconfig.browser.json`, so the projects are exclusive rather than
  // additive — a host-only global on the `.` entry fails to compile.
  "exclude": ["src/client", "src/browser"],
  "include": ["src", "../../types/universal-web.d.ts"]
}
