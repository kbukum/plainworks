{
  "name": "@plainworks/std",
  "version": "0.1.0-alpha.1",
  "description": "Zero-dependency, host-independent standard-library primitives and shared contracts for plainworks.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/std#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/std"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "host-independent",
    "result",
    "errors",
    "guards",
    "contracts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./emitter": {
      "@plainworks/source": "./src/emitter/index.ts",
      "types": "./dist/emitter.d.ts",
      "default": "./dist/emitter.js"
    },
    "./encoding": {
      "@plainworks/source": "./src/encoding/index.ts",
      "types": "./dist/encoding.d.ts",
      "default": "./dist/encoding.js"
    },
    "./failure": {
      "@plainworks/source": "./src/failure/index.ts",
      "types": "./dist/failure.d.ts",
      "default": "./dist/failure.js"
    },
    "./list": {
      "@plainworks/source": "./src/list/index.ts",
      "types": "./dist/list.d.ts",
      "default": "./dist/list.js"
    },
    "./pipeline": {
      "@plainworks/source": "./src/pipeline/index.ts",
      "types": "./dist/pipeline.d.ts",
      "default": "./dist/pipeline.js"
    },
    "./privacy": {
      "@plainworks/source": "./src/privacy/index.ts",
      "types": "./dist/privacy.d.ts",
      "default": "./dist/privacy.js"
    },
    "./random": {
      "@plainworks/source": "./src/random/index.ts",
      "types": "./dist/random.d.ts",
      "default": "./dist/random.js"
    },
    "./resilience": {
      "@plainworks/source": "./src/resilience/index.ts",
      "types": "./dist/resilience.d.ts",
      "default": "./dist/resilience.js"
    },
    "./seam": {
      "@plainworks/source": "./src/seam/index.ts",
      "types": "./dist/seam.d.ts",
      "default": "./dist/seam.js"
    },
    "./time": {
      "@plainworks/source": "./src/time/index.ts",
      "types": "./dist/time.d.ts",
      "default": "./dist/time.js"
    },
    "./web": {
      "@plainworks/source": "./src/web/index.ts",
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check-packaging": "plainworks-release check-packaging"
  },
  "devDependencies": {
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
