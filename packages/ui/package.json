{
  "name": "@plainworks/ui",
  "version": "0.1.0-alpha.1",
  "description": "Accessible, ownable React components and theme building blocks for plainworks applications.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Plainworks",
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "dependencies": {
    "@plainworks/elements": "workspace:*",
    "@plainworks/std": "workspace:*",
    "@plainworks/theme": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js"
    },
    "./overlays": {
      "types": "./dist/overlays.d.ts",
      "import": "./dist/overlays.js"
    },
    "./display": {
      "types": "./dist/display.d.ts",
      "import": "./dist/display.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "import": "./dist/data-table.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js"
    },
    "./list": {
      "types": "./dist/list.d.ts",
      "import": "./dist/list.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js"
    },
    "./theme": {
      "types": "./dist/theme-client.d.ts",
      "import": "./dist/theme-client.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "registry.json",
    "src/client",
    "src/hooks",
    "src/region",
    "!src/client/**/*.test.*",
    "!src/hooks/**/*.test.*",
    "!src/region/**/*.test.*"
  ],
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/ui#readme",
  "keywords": [
    "esm",
    "host-independent",
    "plainworks",
    "typescript"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "build": "tsdown",
    "check-packaging": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints @plainworks/ui/styles.css",
    "codegen": "node scripts/codegen/cli.mjs",
    "lint": "biome check .",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json"
  }
}
