{
  "extends": "../../tsconfig.base.json",
  // Client project, but React-without-DOM: the `./client` provider and hooks are pure React context
  // over the neutral transports, so they compile against the universal-web shim, never the DOM libs.
  // That keeps `@plainworks/channel/client` usable on React Native/Expo as well as in the browser.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "include": ["src/client.ts", "src/client", "../../types/universal-web.d.ts"]
}
