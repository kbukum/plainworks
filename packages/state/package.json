{
  "name": "@plainworks/state",
  "version": "0.1.0-alpha.1",
  "description": "Engine-neutral client-state seam with a built-in default store, SSR/RSC-safe by construction.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Plainworks",
  "homepage": "https://github.com/kbukum/plainworks/tree/main/packages/state#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbukum/plainworks.git",
    "directory": "packages/state"
  },
  "bugs": "https://github.com/kbukum/plainworks/issues",
  "keywords": [
    "plainworks",
    "typescript",
    "esm",
    "host-independent",
    "state-management",
    "zustand",
    "ssr",
    "rsc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    ".": {
      "@plainworks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "@plainworks/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./client/scope": {
      "@plainworks/source": "./src/client/scope/index.ts",
      "types": "./dist/client/scope.d.ts",
      "default": "./dist/client/scope.js"
    },
    "./client/supplied": {
      "@plainworks/source": "./src/client/supplied.ts",
      "types": "./dist/client/supplied.d.ts",
      "default": "./dist/client/supplied.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run --coverage",
    "check-packaging": "plainworks-release check-packaging"
  },
  "dependencies": {
    "@plainworks/std": "workspace:*",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@plainworks/testkit": "workspace:*",
    "@plainworks/tsdown-config": "workspace:*",
    "@plainworks/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  }
}
