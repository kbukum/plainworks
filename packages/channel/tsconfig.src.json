{
  "extends": "../../tsconfig.base.json",
  // Server project: the `.` entry (core + sse/ws transports + event router) must stay DOM-free, so
  // the client graph (`src/client.ts` + `src/client/`) is excluded here and typechecked with the DOM
  // libs via `tsconfig.client.json`.
  "exclude": ["src/client.ts", "src/client"],
  "include": ["src", "../../types/universal-web.d.ts"]
}
